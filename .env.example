# Скопируйте в .env и заполните: cp .env.example .env
# .env содержит токен — не коммитьте его.

# Токен от @BotFather
BOT_TOKEN=123456:AAA-your-token-here

# Дни отправки (mon,tue,wed,thu,fri,sat,sun) и время в этой таймзоне.
# SEND_TIME используется скриптом только для сообщений вида «следующая отправка»;
# фактическое время задаёт systemd timer / cron — держите их согласованными.
SEND_DAYS=wed,sun
SEND_TIME=12:00
TIMEZONE=Europe/Moscow

# Файл с текстом сообщения (относительный путь — от папки проекта)
MESSAGE_FILE=message.txt

# Пусто = обычный текст. Можно MarkdownV2 или HTML, но тогда текст нужно экранировать.
PARSE_MODE=

# Куда писать состояние (получатели + offset getUpdates)
STATE_FILE=state.json

# Необязательно: chat_id через запятую, если знаете их и не хотите ждать /start
CHAT_IDS=

LOG_LEVEL=INFO
